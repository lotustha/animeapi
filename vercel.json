{
  "version": 2,
  "installCommand": "bun install",
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "CUSTOM_DOMAIN": "vercel.app"
  }
}
